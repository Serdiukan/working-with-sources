    given-names: Igor
version: 1.0.0
date-released: 2026-10-31
license: CC-BY-4.0
repository-code: "https://github.com/Serdiukan/working-with-sources"
keywords:
  - historical demography
  - history of the family
  - economic history
  - Hetmanate
  - General Description of Little Russia
  - Rumiantsev Description
  - Poltava
  - source criticism
